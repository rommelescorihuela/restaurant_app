# =============================================================================
# Restaurant SaaS — ejemplo de configuración de entorno
# -----------------------------------------------------------------------------
# Uso (desde restaurant-app/):
#   cp .env.example .env
#   php artisan key:generate
# Requiere PostgreSQL. La app es multi-tenant (stancl/tenancy) con una base
# compartida. NUNCA subas el archivo .env real al repositorio.
# =============================================================================

# --- Aplicación -------------------------------------------------------------
APP_NAME="Restaurant App"
APP_ENV=local                 # local | testing | production
APP_KEY=                      # se genera con: php artisan key:generate
APP_DEBUG=true                # en producción: false
APP_URL=http://localhost

# --- Localización -----------------------------------------------------------
# La interfaz y los datos son en español; el locale de Laravel se deja en "en".
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

# --- Mantenimiento ----------------------------------------------------------
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# --- Logs -------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug               # en producción: error

# --- Base de datos (PostgreSQL) ---------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=restaurant_app
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- Sesión -----------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# --- Broadcast / Archivos / Colas -------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# --- Caché ------------------------------------------------------------------
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# --- Redis (opcional) -------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Correo -----------------------------------------------------------------
MAIL_MAILER=log               # en producción: smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Almacenamiento S3 (opcional) -------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Frontend (Vite) --------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# --- Multi-tenancy ----------------------------------------------------------
# Dominios centrales (sin tenant). En producción pon tu dominio principal; los
# restaurantes se accederán como {restaurante}.tudominio.com
TENANCY_CENTRAL_DOMAINS=localhost:8000,127.0.0.1:8000
